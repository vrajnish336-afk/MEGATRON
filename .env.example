# ==============================================================================
# MEGADRONE Business OS - Environment Configuration Example
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Database Configuration
# For SQLite (default development):
DATABASE_TYPE=sqlite
DATABASE_FILE=./data/megadrone.sqlite

# For PostgreSQL (production):
# DATABASE_TYPE=postgres
# DATABASE_URL=postgresql://user:password@localhost:5432/megadrone

# AI Provider Configuration - Cloud AI (OpenAI / Gemini / Anthropic / Custom compatible)
CLOUD_AI_PROVIDER=openai_compatible
CLOUD_AI_API_KEY=
CLOUD_AI_BASE_URL=https://api.openai.com/v1
CLOUD_AI_MODEL=gpt-4o-mini
CLOUD_AI_TIMEOUT_MS=30000
CLOUD_AI_MAX_RETRIES=2

# AI Provider Configuration - Local AI (Ollama)
LOCAL_OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_OLLAMA_MODEL=llama3.2:latest
LOCAL_OLLAMA_TIMEOUT_MS=60000

# AI Routing Strategy (options: dynamic, prefer_local, prefer_cloud, force_local, force_cloud)
AI_ROUTING_STRATEGY=dynamic

# Data Privacy Policies (Data classification outbound rules)
ALLOW_CLOUD_FOR_PUBLIC=true
ALLOW_CLOUD_FOR_INTERNAL=true
ALLOW_CLOUD_FOR_CONFIDENTIAL=false
ALLOW_CLOUD_FOR_SENSITIVE=false

# Logging & Auditing
LOG_LEVEL=info
ENABLE_AUDIT_LOG=true
SANITIZE_SECRETS_IN_LOGS=true
