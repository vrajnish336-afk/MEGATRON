# ==============================================================================
# MEGATRON Business OS - Production Environment Configuration Template
# Place this file as `.env.production` on the production host server.
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# CORS Allowed Origin (Must match your production domain)
FRONTEND_URL=https://yourdomain.com

# Security & Authentication (MUST be a random string >= 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_CRYPTOGRAPHICALLY_SECURE_RANDOM_STRING_MIN_32_CHARS
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Database Configuration (SQLite Named Persistent Volume)
DATABASE_TYPE=sqlite
DATABASE_FILE=/app/data/megadrone.sqlite

# Local Ollama AI Provider Configuration (Private Docker Internal Network)
LOCAL_OLLAMA_BASE_URL=http://ollama:11434
LOCAL_OLLAMA_MODEL=llama3.2:latest
LOCAL_OLLAMA_TIMEOUT_MS=60000

# AI Routing Strategy (dynamic, prefer_local, force_local)
AI_ROUTING_STRATEGY=dynamic

# Data Privacy Governance Rules
ALLOW_CLOUD_FOR_PUBLIC=true
ALLOW_CLOUD_FOR_INTERNAL=true
ALLOW_CLOUD_FOR_CONFIDENTIAL=false
ALLOW_CLOUD_FOR_SENSITIVE=false

# Production Logging & Auditing
LOG_LEVEL=info
ENABLE_AUDIT_LOG=true
SANITIZE_SECRETS_IN_LOGS=true

# Security Rate Limiting (10 requests per minute on login)
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=60000
